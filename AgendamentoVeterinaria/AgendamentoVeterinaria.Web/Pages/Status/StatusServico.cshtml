@page
@model AgendamentoVeterinaria.Web.Pages.Status.StatusServicoModel
@using AgendamentoVeterinaria.Domain.Entities
@using AgendamentoVeterinaria.Domain.Interfaces
@section NoScroll { }

<div class="flex min-h-screen select-none flex-col gap-5 bg-gray-200">
	<div class="mt-10 flex flex-col gap-4">
		<div class="flex justify-center">
			<h1 class="border text-4xl font-extrabold text-gray-400">Status: andamento do serviço</h1>
		</div>
		<div class="flex w-full justify-center px-4 pb-12">
			<div class="h-[650px] w-full max-w-[1600px] overflow-auto rounded-2xl bg-white shadow-lg">
				<table class="relative w-full text-left text-sm text-gray-700">
					<thead class="bg-cyan-700 text-white">
						<tr>
							<th class="sticky px-6 py-3 text-xs font-bold uppercase tracking-wider">Nome do Dono</th>
							<th class="sticky px-6 py-3 text-xs font-bold uppercase tracking-wider">Nome do Pet</th>
							<th class="sticky px-6 py-3 text-center text-xs font-bold uppercase tracking-wider">Serviço</th>
							<th class="sticky px-6 py-3 text-center text-xs font-bold uppercase tracking-wider">Status</th>
							<th class="sticky px-6 py-3 text-center text-xs font-bold uppercase tracking-wider">Ações</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-gray-200">
						@if (Model.AgendamentoConsultas != null && Model.AgendamentoConsultas.Any())
						{
							foreach (var agendamento in Model.AgendamentoConsultas)
							{
								<tr class="transition hover:bg-gray-50">
									<td class="px-6 py-3">@agendamento.NomeDono</td>
									<td class="px-6 py-3">@agendamento.NomePet</td>
									<td class="px-6 py-3">
										@if (agendamento.TipoServico == "Veterinária")
										{
											<div class="rounded-2xl bg-sky-100 px-2 py-0.5 text-center font-medium text-sky-500">
												@agendamento.TipoServico
											</div>
										}
										else
										{
											<div class="rounded-2xl bg-green-100 px-2 py-0.5 text-center font-medium text-green-500">
												@agendamento.TipoServico
											</div>
										}
									</td>
									<td class="px-6 py-3 text-center">
										@switch (agendamento.Status)
										{
											case "Aguardando":
												<span class="inline-flex items-center rounded-full bg-yellow-100 px-3 py-1 font-medium text-yellow-800">
													@agendamento.Status
												</span>
												break;
											case "Em andamento":
												<span class="inline-flex items-center rounded-full bg-yellow-100 px-3 py-1 font-medium text-yellow-800">
													@agendamento.Status >>
												</span>
												break;
											case "Finalizado":
												<span class="inline-flex items-center rounded-full bg-green-100 px-3 py-1 font-semibold text-green-800">
													@agendamento.Status
												</span>
												break;
											default:
												<span class="inline-flex items-center rounded-full bg-gray-100 px-3 py-1 font-medium text-gray-800">
													@agendamento.Status
												</span>
												break;
										}
									</td>
									<td class="px-6 py-3 text-center">
										<div class="flex items-center justify-center gap-1">
											@if (agendamento.Status != "Finalizado")
											{
												<form method="post" asp-page-handler="AvancarStatus" asp-route-id="@agendamento.Id">
													<button type="submit"
															class="flex items-center justify-center gap-1.5 rounded-lg bg-green-600 p-2 text-white transition hover:bg-green-700"
															title="Avançar Status">
														<span class="font-bold">Próximo</span>
														<i class='bx bx-chevron-right text-xl'></i>
													</button>
												</form>
											}
											else
											{
												<span class="text-sm text-gray-500"></span>
											}
										</div>
									</td>
								</tr>
							}
						}
						else
						{
							<tr>
								<td colspan="5" class="p-6 text-center text-gray-500">Nenhum agendamento encontrado.</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>